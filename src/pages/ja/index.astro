---
import Layout from '../../layouts/Layout.astro';

const perma = [
  { letter: 'P', label: 'ポジティブ感情', desc: '喜び・感謝・希望' },
  { letter: 'E', label: 'エンゲージメント', desc: 'フロー・没頭' },
  { letter: 'R', label: '関係性', desc: '社会的つながり' },
  { letter: 'M', label: '意味・意義', desc: '目的と所属感' },
  { letter: 'A', label: '達成', desc: '目標と熟達' },
  { letter: '✦', label: 'フラーリッシュ', desc: '全体的な繁栄' },
];

const mentalSkills = [
  { icon: '🎯', label: '目標設定', desc: '方向と集中力' },
  { icon: '🔥', label: 'モチベーション', desc: '努力の原動力' },
  { icon: '👁️', label: '集中力', desc: '注意のコントロール' },
  { icon: '💭', label: 'イメージ', desc: 'メンタルリハーサル' },
  { icon: '💬', label: 'セルフトーク', desc: '内なる対話' },
  { icon: '🔄', label: 'ルーティン', desc: '試合前の準備' },
];
---

<Layout title="ホーム">
  <!-- Hero -->
  <div class="relative -mt-10 mb-12 h-[480px] overflow-hidden w-screen" style="margin-left: calc(50% - 50vw)">
    <img
      src="/images/hero.jpg"
      alt="ノートとペンが置かれたデスク"
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/20 to-base-200" />
    <div class="absolute inset-0 flex flex-col items-center justify-center text-center px-4">
      <h1 class="text-5xl font-bold text-white drop-shadow mb-4">Psychology Notes</h1>
      <p class="text-white/85 text-lg max-w-2xl mb-8">
        カレッジの一般教養コースで学んだ心理学の基礎をまとめたノートです。
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="/ja/positive" class="btn btn-secondary text-white">ポジティブ心理学を学ぶ</a>
        <a href="/ja/performance" class="btn btn-primary text-white">パフォーマンス心理学を学ぶ</a>
      </div>
    </div>
  </div>

  <!-- Section 1: Positive Psychology -->
  <section class="py-10">
    <div class="grid lg:grid-cols-2 gap-10 items-start">
      <!-- Text -->
      <div>
        <span class="badge badge-soft badge-secondary mb-3">ポジティブ心理学</span>
        <h2 class="text-3xl font-bold mb-4">人生を充実させるものは何か？</h2>
        <p class="text-base-content/70 leading-relaxed mb-3">
          ポジティブ心理学は、ウェルビーイングと人間の繁栄を科学的に研究する分野です。1998年にマーティン・セリグマンによって提唱され、障害の治療だけでなく、「充実した人生とは何か」に焦点を当てます。
        </p>
        <p class="text-base-content/70 leading-relaxed mb-4">
          <strong class="text-base-content">PERMAモデル</strong>はウェルビーイングの5つの要素を示す研究に基づいたフレームワークで、性格的強み・レジリエンス・フロー・感謝・マインドフルネスの研究によって支えられています。
        </p>
        <!-- Desktop only CTA -->
        <a href="/ja/positive" class="hidden lg:inline link link-secondary font-medium">ポジティブ心理学のノートを見る →</a>
      </div>

      <!-- PERMA Grid -->
      <div class="grid grid-cols-3 gap-3">
        {perma.map(({ letter, label, desc }) => (
          <div class="card bg-base-100 shadow-sm p-4 text-center">
            <div class="text-2xl font-bold text-secondary mb-1">{letter}</div>
            <div class="text-xs font-semibold mb-1">{label}</div>
            <div class="text-xs text-base-content/50">{desc}</div>
          </div>
        ))}
      </div>

      <!-- Mobile only CTA (appears after grid on narrow screens) -->
      <a href="/ja/positive" class="lg:hidden link link-secondary font-medium">ポジティブ心理学のノートを見る →</a>
    </div>
  </section>

  <div class="divider my-2" />

  <!-- Section 2: Performance Psychology -->
  <section class="py-10">
    <div class="grid lg:grid-cols-2 gap-10 items-start">
      <!-- Text (right on desktop, first on mobile) -->
      <div class="lg:order-2">
        <span class="badge badge-soft badge-primary mb-3">パフォーマンス心理学</span>
        <h2 class="text-3xl font-bold mb-4">ピークパフォーマンスの心理学</h2>
        <p class="text-base-content/70 leading-relaxed mb-3">
          パフォーマンス心理学は、心理学の知見をスポーツや競技など高プレッシャーの場でのパフォーマンス最適化に応用する分野です。一貫性・レジリエンス・最高のパフォーマンスを生み出すメンタルスキルに焦点を当てます。
        </p>
        <p class="text-base-content/70 leading-relaxed mb-4">
          目標設定・セルフトーク・試合前ルーティンなど、これらの<strong class="text-base-content">エビデンスに基づくメンタルスキル</strong>は、身体的スキルと同様に意図的な練習によって鍛えられます。
        </p>
        <!-- Desktop only CTA -->
        <a href="/ja/performance" class="hidden lg:inline link link-primary font-medium">パフォーマンス心理学のノートを見る →</a>
      </div>

      <!-- Skills Grid (left on desktop, second on mobile) -->
      <div class="grid grid-cols-3 gap-3 lg:order-1">
        {mentalSkills.map(({ icon, label, desc }) => (
          <div class="card bg-base-100 shadow-sm p-4 text-center">
            <div class="text-2xl mb-1">{icon}</div>
            <div class="text-xs font-semibold text-primary mb-1">{label}</div>
            <div class="text-xs text-base-content/50">{desc}</div>
          </div>
        ))}
      </div>

      <!-- Mobile only CTA (appears after grid on narrow screens) -->
      <a href="/ja/performance" class="lg:hidden link link-primary font-medium">パフォーマンス心理学のノートを見る →</a>
    </div>
  </section>
</Layout>
