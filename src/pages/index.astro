---
import Layout from '../layouts/Layout.astro';

const perma = [
  { letter: 'P', label: 'Positive Emotions', desc: 'Joy, gratitude & hope' },
  { letter: 'E', label: 'Engagement', desc: 'Flow & absorption' },
  { letter: 'R', label: 'Relationships', desc: 'Social connection' },
  { letter: 'M', label: 'Meaning', desc: 'Purpose & belonging' },
  { letter: 'A', label: 'Achievement', desc: 'Goals & mastery' },
  { letter: '✦', label: 'Flourishing', desc: 'Thriving as a whole' },
];

const mentalSkills = [
  { icon: '🎯', label: 'Goal-Setting', desc: 'Direction & focus' },
  { icon: '🔥', label: 'Motivation', desc: 'Drive to perform' },
  { icon: '👁️', label: 'Focus', desc: 'Attention control' },
  { icon: '💭', label: 'Imagery', desc: 'Mental rehearsal' },
  { icon: '💬', label: 'Self-Talk', desc: 'Inner dialogue' },
  { icon: '🔄', label: 'Routines', desc: 'Pre-performance prep' },
];
---

<Layout title="Home">
  <!-- Hero -->
  <div class="relative -mt-10 mb-12 h-[480px] overflow-hidden w-screen" style="margin-left: calc(50% - 50vw)">
    <img
      src="/images/hero.jpg"
      alt="A notebook and pen on a desk"
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/20 to-base-200" />
    <div class="absolute inset-0 flex flex-col items-center justify-center text-center px-4">
      <h1 class="text-5xl font-bold text-white drop-shadow mb-4">Psychology Notes</h1>
      <p class="text-white/85 text-lg max-w-xl mb-8">
        Study notes from a college general education course covering the fundamentals of psychology.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="/positive" class="btn btn-secondary text-white">Learn Positive Psychology</a>
        <a href="/performance" class="btn btn-primary text-white">Learn Performance Psychology</a>
      </div>
    </div>
  </div>

  <!-- Section 1: Positive Psychology -->
  <section class="py-10">
    <div class="grid lg:grid-cols-2 gap-10 items-start">
      <!-- Text -->
      <div>
        <span class="badge badge-soft badge-secondary mb-3">Positive Psychology</span>
        <h2 class="text-3xl font-bold mb-4">What Makes Life Worth Living?</h2>
        <p class="text-base-content/70 leading-relaxed mb-3">
          Positive psychology is the scientific study of well-being and human flourishing. Founded by Martin Seligman in 1998, it shifts the focus from disorder to thriving — exploring what enables individuals and communities to live well.
        </p>
        <p class="text-base-content/70 leading-relaxed mb-4">
          The <strong class="text-base-content">PERMA model</strong> provides a research-backed framework for well-being, supported by work on character strengths, resilience, flow, gratitude, and mindfulness.
        </p>
        <!-- Desktop only CTA -->
        <a href="/positive" class="hidden lg:inline link link-secondary font-medium">Browse Positive Psychology Notes →</a>
      </div>

      <!-- PERMA Grid -->
      <div class="grid grid-cols-3 gap-3">
        {perma.map(({ letter, label, desc }) => (
          <div class="card bg-base-100 shadow-sm p-4 text-center">
            <div class="text-2xl font-bold text-secondary mb-1">{letter}</div>
            <div class="text-xs font-semibold mb-1">{label}</div>
            <div class="text-xs text-base-content/50">{desc}</div>
          </div>
        ))}
      </div>

      <!-- Mobile only CTA (appears after grid on narrow screens) -->
      <a href="/positive" class="lg:hidden link link-secondary font-medium lg:col-start-1">Browse Positive Psychology Notes →</a>
    </div>
  </section>

  <div class="divider my-2" />

  <!-- Section 2: Performance Psychology -->
  <section class="py-10">
    <div class="grid lg:grid-cols-2 gap-10 items-start">
      <!-- Text (right on desktop, first on mobile) -->
      <div class="lg:order-2">
        <span class="badge badge-soft badge-primary mb-3">Performance Psychology</span>
        <h2 class="text-3xl font-bold mb-4">The Psychology of Peak Performance</h2>
        <p class="text-base-content/70 leading-relaxed mb-3">
          Performance psychology applies psychological science to help athletes and competitors perform at their best under pressure. It focuses on the mental skills that determine consistency, resilience, and peak output.
        </p>
        <p class="text-base-content/70 leading-relaxed mb-4">
          These <strong class="text-base-content">evidence-based mental skills</strong> — from goal-setting and self-talk to pre-performance routines — are trainable through deliberate practice, just like physical skills.
        </p>
        <!-- Desktop only CTA -->
        <a href="/performance" class="hidden lg:inline link link-primary font-medium">Browse Performance Psychology Notes →</a>
      </div>

      <!-- Skills Grid (left on desktop, second on mobile) -->
      <div class="grid grid-cols-3 gap-3 lg:order-1">
        {mentalSkills.map(({ icon, label, desc }) => (
          <div class="card bg-base-100 shadow-sm p-4 text-center">
            <div class="text-2xl mb-1">{icon}</div>
            <div class="text-xs font-semibold text-primary mb-1">{label}</div>
            <div class="text-xs text-base-content/50">{desc}</div>
          </div>
        ))}
      </div>

      <!-- Mobile only CTA (appears after grid on narrow screens) -->
      <a href="/performance" class="lg:hidden link link-primary font-medium lg:order-3">Browse Performance Psychology Notes →</a>
    </div>
  </section>
</Layout>
